{
  "name": "assistme-virtual-assistant",
  "version": "3.0.0",
  "description": "Next-generation AI virtual assistant with multimodal interactions, real-time voice processing, multilingual support (22+ Indian languages), and advanced RAG technology",
  "main": "index.html",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .js,.jsx --report-unused-disable-directives --max-warnings 150",
    "test": "vitest run",
    "lint:fix": "eslint src --ext .js,.jsx --fix --max-warnings 150",
    "format": "prettier --write \"src/**/*.{js,jsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css,json}\"",
    "serve:frontend": "npx http-server . -p 3000 -c-1 --cors",
    "serve:backend": "cd backend && source venv/bin/activate && python -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8001",
    "start": "npm-run-all --parallel serve:*",
    "backend:setup": "cd backend && python -m venv venv && source venv/bin/activate && pip install -r requirements.txt",
    "db:migrate": "cd backend && alembic upgrade head",
    "pages:build": "npm run build",
    "typecheck": "tsc --noEmit 2>/dev/null || true",
    "clean": "rm -rf dist node_modules/.cache",
    "validate-paths": "node scripts/validate-paths.mjs"
  },
  "keywords": [
    "ai",
    "chat",
    "assistant",
    "virtual-assistant",
    "voice",
    "multilingual",
    "rag",
    "openrouter",
    "react",
    "fastapi",
    "frontend",
    "backend"
  ],
  "author": "Mangesh Raut <mbr63@drexel.edu>",
  "license": "MIT",
  "homepage": "https://mangeshraut712.github.io/AssistMe-VirtualAssistant/",
  "bugs": {
    "url": "https://github.com/mangeshraut712/AssistMe-VirtualAssistant/issues"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-legacy": "^8.2.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "http-server": "^14.1.1",
    "jsdom": "^26.1.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.10",
    "terser": "^5.51.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mangeshraut712/AssistMe-VirtualAssistant.git"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@vitejs/plugin-react": "^5.2.0",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.16",
    "framer-motion": "^14.1.1",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.554.0",
    "marked": "^17.0.1",
    "postcss": "^8.5.29",
    "react": "^19.2.0",
    "react-dom": "^19.3.0",
    "react-is": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7"
  },
  "engines": {
    "node": "20.x"
  }
}
